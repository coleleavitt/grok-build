[
  {
    "description": "Verify credential resolution does not implicitly pin to index 0 when active_index is null/absent; selection should follow normal ordering rules (health/tier/name).",
    "id": "TC001",
    "kind": "backend",
    "steps": [
      {
        "body": {
          "accounts": [
            {
              "healthy": true,
              "id": "acc_b",
              "name": "beta",
              "tier": 2
            },
            {
              "healthy": true,
              "id": "acc_a",
              "name": "alpha",
              "tier": 1
            },
            {
              "healthy": false,
              "id": "acc_c",
              "name": "gamma",
              "tier": 3
            }
          ],
          "active_index": null,
          "provider": "anthropic"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_ADMIN_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/test/accounts/seed"
      },
      {
        "body": {
          "provider": "anthropic"
        },
        "expect_json": {
          "selected_account_id": "acc_a",
          "selection_reason": "ranking"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/v1/credentials/resolve"
      }
    ],
    "title": "Select account by ranking when active_index is absent"
  },
  {
    "description": "Verify explicit active_index pins selection to that account when it is healthy/ready.",
    "id": "TC002",
    "kind": "backend",
    "steps": [
      {
        "body": {
          "accounts": [
            {
              "healthy": true,
              "id": "acc_0",
              "name": "alpha",
              "tier": 1
            },
            {
              "healthy": true,
              "id": "acc_1",
              "name": "beta",
              "tier": 2
            }
          ],
          "active_index": 1,
          "provider": "anthropic"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_ADMIN_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/test/accounts/seed"
      },
      {
        "body": {
          "provider": "anthropic"
        },
        "expect_json": {
          "selected_account_id": "acc_1",
          "selection_reason": "sticky_active_index"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/v1/credentials/resolve"
      }
    ],
    "title": "Preserve sticky selection when explicit active_index is healthy"
  },
  {
    "description": "On Anthropic rate limit with Retry-After header, selected account is marked rejected/cooled down and next resolve rotates to another ready account.",
    "id": "TC003",
    "kind": "backend",
    "steps": [
      {
        "body": {
          "accounts": [
            {
              "healthy": true,
              "id": "acc_0",
              "name": "alpha",
              "tier": 1
            },
            {
              "healthy": true,
              "id": "acc_1",
              "name": "beta",
              "tier": 1
            }
          ],
          "active_index": 1,
          "provider": "anthropic"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_ADMIN_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/test/accounts/seed"
      },
      {
        "body": {
          "provider": "anthropic"
        },
        "expect_json": {
          "selected_account_id": "acc_1"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/v1/credentials/resolve"
      },
      {
        "body": {
          "account_id": "acc_1",
          "error_type": "RateLimited"
        },
        "expect_json": {
          "account_id": "acc_1",
          "unified_status": "Rejected"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}",
          "Content-Type": "application/json",
          "Retry-After": "120"
        },
        "method": "POST",
        "path": "/v1/providers/anthropic/rate-limit"
      },
      {
        "expect_json": {
          "id": "acc_1",
          "unified_status": "Rejected"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}"
        },
        "method": "GET",
        "path": "/v1/accounts/acc_1"
      },
      {
        "body": {
          "provider": "anthropic"
        },
        "expect_json": {
          "selected_account_id": "acc_0",
          "selection_reason": "rotated_after_rate_limit"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/v1/credentials/resolve"
      }
    ],
    "title": "Mark selected account rejected with retry-after and rotate"
  },
  {
    "description": "If rate limit response has no Retry-After metadata, system applies default cooldown window (300 seconds) and marks account rejected.",
    "id": "TC004",
    "kind": "backend",
    "spec": {
      "body": {
        "account_id": "${RL_ACCOUNT_ID}",
        "error_type": "RateLimited",
        "retry_after_seconds": null
      },
      "expect_json": {
        "account_id": "${RL_ACCOUNT_ID}",
        "cooldown_seconds": 300,
        "unified_status": "Rejected"
      },
      "expect_status": 200,
      "headers": {
        "Authorization": "Bearer ${TEST_USER_TOKEN}",
        "Content-Type": "application/json"
      },
      "method": "POST",
      "path": "/v1/providers/anthropic/rate-limit"
    },
    "title": "Apply 5-minute cooldown fallback when retry-after missing"
  },
  {
    "description": "After recording rate limit for selected account, cached bearer credential is cleared so next credential fetch cannot reuse exhausted token.",
    "id": "TC005",
    "kind": "backend",
    "steps": [
      {
        "body": {
          "account_id": "acc_cache",
          "bearer": "${EXHAUSTED_BEARER_TOKEN}",
          "provider": "anthropic"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_ADMIN_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/test/bearer-cache/seed"
      },
      {
        "expect_json": {
          "cached": true
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}"
        },
        "method": "GET",
        "path": "/v1/credentials/cache/status?provider=anthropic&account_id=acc_cache"
      },
      {
        "body": {
          "account_id": "acc_cache",
          "error_type": "RateLimited"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/v1/providers/anthropic/rate-limit"
      },
      {
        "expect_json": {
          "cached": false
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}"
        },
        "method": "GET",
        "path": "/v1/credentials/cache/status?provider=anthropic&account_id=acc_cache"
      }
    ],
    "title": "Invalidate process-local bearer cache on rate limit record"
  },
  {
    "description": "Sampler RateLimited outcome should trigger credential mark/rotate/refresh workflow and then use existing resubmit path to continue successfully.",
    "id": "TC006",
    "kind": "backend",
    "steps": [
      {
        "body": {
          "accounts": [
            {
              "id": "acc_0",
              "ready": true
            },
            {
              "id": "acc_1",
              "ready": true
            }
          ],
          "provider": "anthropic",
          "scenario": "rate_limit_then_recover"
        },
        "expect_json": {
          "session_id": "${SESSION_ID}"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/test/sampler/session/start",
        "save": {
          "SESSION_ID": "$.session_id"
        }
      },
      {
        "body": {
          "prompt": "hello",
          "session_id": "${SESSION_ID}"
        },
        "expect_json": {
          "final_status": "ok",
          "recovery_path": "resubmit",
          "rotated": true
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_USER_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/v1/sampler/turn"
      }
    ],
    "title": "Sampler Anthropic RateLimited error follows rotate+resubmit recovery"
  },
  {
    "description": "If all Anthropic accounts are rejected/unavailable after RateLimited handling, session should return exhausted outcome.",
    "id": "TC007",
    "kind": "backend",
    "spec": {
      "body": {
        "prompt": "trigger rate limit",
        "session_id": "${EXHAUSTED_SESSION_ID}"
      },
      "expect_json": {
        "final_status": "exhausted",
        "rotated": false
      },
      "expect_status": 200,
      "headers": {
        "Authorization": "Bearer ${TEST_USER_TOKEN}",
        "Content-Type": "application/json"
      },
      "method": "POST",
      "path": "/v1/sampler/turn"
    },
    "title": "Sampler returns exhausted only when no replacement account remains"
  },
  {
    "description": "Validate security constraint that test/log endpoints and artifacts do not expose bearer tokens or refresh secrets; intended for CI safety checks without live API dependency.",
    "id": "TC008",
    "kind": "backend",
    "steps": [
      {
        "body": {
          "offline": true,
          "provider": "anthropic"
        },
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_ADMIN_TOKEN}",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/test/offline/auth/run"
      },
      {
        "expect_body": "must_not_contain:${EXHAUSTED_BEARER_TOKEN}",
        "expect_parses": "json",
        "expect_status": 200,
        "headers": {
          "Authorization": "Bearer ${TEST_ADMIN_TOKEN}"
        },
        "method": "GET",
        "path": "/test/artifacts/latest"
      }
    ],
    "title": "No secret leakage in auth/log artifacts during offline test runs"
  }
]